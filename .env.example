MONGODB_URI=mongodb://127.0.0.1:27017/jira-project-tracker
AUTH_SECRET=replace-with-openssl-rand-base64-32
# Local only. On Vercel these are set automatically from the deployment / production domain.
AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
AUTH_TRUST_HOST=true
CRON_SECRET=replace-with-a-long-random-string
BLOB_READ_WRITE_TOKEN=
RESEND_API_KEY=
RESEND_FROM=Jira Project Tracker <noreply@example.com>
JIRA_SYNC_ENABLED=false
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# Optional feature flags (true/false). Unset means off unless documented otherwise.
FEATURE_JIRA_SYNC=false

